# magiis-api-e2e — variables de entorno
# Ambientes del proyecto: UAT y PROD (TEST fuera). Copiar a .env.uat (ejecución) o .env.prod (read-only).
# NUNCA commitear .env.* con valores reales.
#
# UAT  → ENV=uat  · BASE_URL=https://apps-uat.example.com · MAGIIS_API_PREFIX=magiis-v0.2/  (env seguro de ejecución)
# PROD → ENV=prod · BASE_URL=https://api.apps.example.com  · MAGIIS_API_PREFIX=            (prefijo VACÍO; solo read-only)

# Env activo (lo lee playwright.config.ts y runtime.ts)
ENV=uat

# Backend Magiis — apuntar al host correspondiente (defaults = UAT)
BASE_URL=https://apps-uat.example.com
MAGIIS_API_PREFIX=magiis-v0.2/

# Auth — endpoint y credenciales
AUTH_API_URL=https://apps-uat.example.com/magiis-v0.2/auth/login
LOGIN_USER=
LOGIN_PASSWORD=
LOGIN_ROLE=ROLE_CARRIER

# IDs de pruebas (defaults conocidos)
MAGIIS_TEST_CARRIER_ID=1040
MAGIIS_TEST_DRIVER_ID=1203

# Datos de seed para el harness de mutación (tests/specs/_mutation) — OPCIONALES.
# Sin ellos, los tests que los requieren se auto-saltan (test.skip). Solo UAT + ALLOW_MUTATIONS=1.
# MAGIIS_TEST_CONTRACTOR_ID=       # contractor-area.mutation
# MAGIIS_SEED_PASSENGER_USER_ID=   # client.mutation (addClient enlaza un passenger existente)
# MAGIIS_SEED_CLIENT_ID=           # client.mutation (verify/cleanup del cliente)

# Postman API (solo para scripts/fetch-postman-collection.ts)
# POSTMAN_API_KEY=PMAK-...
