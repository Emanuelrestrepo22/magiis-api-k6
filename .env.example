# magiis-api-e2e — variables de entorno
# Ambientes del proyecto: UAT y PROD (TEST fuera). Copiar a .env.uat (ejecución) o .env.prod (read-only).
# NUNCA commitear .env.* con valores reales.
#
# UAT  → ENV=uat  · BASE_URL=https://apps-uat.example.com · MAGIIS_API_PREFIX=magiis-v0.2/  (env seguro de ejecución)
# PROD → ENV=prod · BASE_URL=https://api.apps.example.com  · MAGIIS_API_PREFIX=            (prefijo VACÍO; solo read-only)

# Env activo (lo lee playwright.config.ts y runtime.ts)
ENV=uat

# Backend Magiis — apuntar al host correspondiente (defaults = UAT)
BASE_URL=https://apps-uat.example.com
MAGIIS_API_PREFIX=magiis-v0.2/

# Auth — endpoint y credenciales
AUTH_API_URL=https://apps-uat.example.com/magiis-v0.2/auth/login
LOGIN_USER=
LOGIN_PASSWORD=
LOGIN_ROLE=ROLE_CARRIER

# IDs de pruebas (defaults conocidos)
MAGIIS_TEST_CARRIER_ID=1040
MAGIIS_TEST_DRIVER_ID=1203

# Datos de seed para el harness de mutación (tests/specs/_mutation) — OPCIONALES.
# Sin ellos, los tests que los requieren se auto-saltan (test.skip). Solo UAT + ALLOW_MUTATIONS=1.
# MAGIIS_TEST_CONTRACTOR_ID=       # contractor-area.mutation
# MAGIIS_SEED_PASSENGER_USER_ID=   # client.mutation (addClient enlaza un passenger existente)
# MAGIIS_SEED_CLIENT_ID=           # client.mutation (verify/cleanup del cliente)

# Postman API — leído por scripts/fetch-postman-collection.ts Y por .mcp.json (Postman MCP, via ${POSTMAN_API_KEY}).
# NUNCA hardcodear la key en .mcp.json; exportarla en el entorno o ponerla aquí en .env (gitignored).
# POSTMAN_API_KEY=PMAK-...

# ============================================================================
# PERFILES DE CREDENCIALES (opcional) — LOGIN_PROFILE
# ============================================================================
# Un mismo ambiente puede tener carriers de mercados distintos, y el catálogo de
# direcciones difiere entre ellos: el perfil cambia QUÉ datos ve la suite, no
# solo con qué usuario entra.
#
#   sin LOGIN_PROFILE  → LOGIN_USER / LOGIN_PASSWORD        (perfil base)
#   LOGIN_PROFILE=usa  → LOGIN_USER_USA / LOGIN_PASSWORD_USA
#
# Pedir un perfil cuyas claves no existan FALLA con mensaje explícito; nunca cae
# a las credenciales base, porque correr contra otro carrier mientras el reporte
# dice otra cosa es evidencia atribuida al actor equivocado.
#
#   LOGIN_PROFILE=usa pnpm test:uat
#
# LOGIN_USER_USA=
# LOGIN_PASSWORD_USA=

# ============================================================================
# ORACLE — pata DB de la trifuerza (READ-ONLY, driver en proceso)
# ============================================================================
# La consume `tests/components/db/OracleDb.ts` vía la fixture `db`. Modo THIN
# (JS puro): NO requiere Oracle Instant Client ni el build nativo de oracledb.
#
# ENV-AWARE, alineado con tests/config/runtime.ts:
#   ENV/TEST_ENV = test (default) → variables con sufijo `_TEST`
#   ENV/TEST_ENV = uat            → variables SIN sufijo
#
# Si falta cualquiera de estas, la fixture `db` entrega `null` y el caso debe
# skipear con motivo — nunca fallar por configuración ausente:
#   test.skip(!db, 'Sin credenciales Oracle: la pata DB no es verificable');
#
# El connect string admite dos formas: `ORACLE_CONNECT_STRING[_TEST]` (Easy
# Connect `host:puerto/service`) o las partes sueltas HOST + PORT + SERVICE.
#
# IMPORTANTE: esto NO se reemplaza con el MCP de base de datos. El MCP es una
# herramienta del AGENTE; un spec corre en un proceso Node sin cliente MCP, así
# que assertar DB dentro del test exige este driver.
# --- UAT (ENV=uat) : SIN sufijo -> magiis-uat-v6 --------------------------
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=            # 1521
ORACLE_SERVICE=

# --- TEST (ENV=test) : sufijo _TEST -> magiis-test-v2 ---------------------
ORACLE_USER_TEST=
ORACLE_PASSWORD_TEST=
ORACLE_HOST_TEST=
ORACLE_PORT_TEST=       # 1521
ORACLE_SERVICE_TEST=    # ORCL

# ─── Xray — Test Plan por defecto del reporter ────────────────────────────────
# Default TM-1283 = ATP-AUTO (plan de stock de automatización MAGIIS).
# Override por campaña con XRAY_TEST_PLAN_KEY. Solo aplica si NO hay XRAY_EXECUTION_KEY.
XRAY_TEST_PLAN_KEY=TM-1283
